{
  "manifest_version": 3,
  "name": "ScreenGuide",
  "version": "0.1.0",
  "description": "Local guidance: ScreenGuide points, you click.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:47823"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
