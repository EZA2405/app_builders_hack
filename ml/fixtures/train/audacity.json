 "goals": {
  "start a brand new recording from scratch": [
   "File > New"
  ],
  "bring in a sound file i already have": [
   "File > Import > Audio...",
   "File > Open..."
  ],
  "save my work so i can keep editing later": [
   "File > Save Project > Save Project"
  ],
  "turn this into an mp3 to send to my grandson": [
   "File > Export Audio..."
  ],
  "undo that": [
   "Edit > Undo"
  ],
  "bring back what i just undid": [
   "Edit > Redo"
  ],
  "get rid of this part": [
   "Edit > Delete"
  ],
  "keep only the bit i highlighted and throw the rest away": [
   "Edit > Remove Special > Trim Audio"
  ],
  "make this part totally quiet but keep the length": [
   "Edit > Remove Special > Silence Audio"
  ],
  "cut the recording into two pieces right here": [
   "Edit > Audio Clips > Split"
  ],
  "pick everything": [
   "Select > All"
  ],
  "i cant see the sound waves theyre too tiny": [
   "View > Zoom > Zoom In"
  ],
  "show the whole recording on the screen at once": [
   "View > Track Size > Fit to Width"
  ],
  "play it back so i can hear how it sounds": [
   "Transport > Playing > Play/Stop"
  ],
  "start recording my voice": [
   "Transport > Recording > Record"
  ],
  "record the radio show automatically at 8 tonight": [
   "Transport > Recording > Timer Record..."
  ],
  "go back to the very beginning": [
   "Transport > Cursor to > Project Start",
   "Transport > Cursor to > Track Start"
  ],
  "play the same thing over and over": [
   "Transport > Looping > Enable Looping"
  ],
  "add another track for a second voice": [
   "Tracks > Add New > Mono Track",
   "Tracks > Add New > Stereo Track"
  ],
  "make it one channel instead of left and right": [
   "Tracks > Mix > Mix Stereo Down to Mono"
  ],
  "the recording is too quiet, make it louder": [
   "Effect > Volume and Compression > Amplify...",
   "Effect > Volume and Compression > Normalize..."
  ],
  "make the music slowly get quieter at the end": [
   "Effect > Fading > Fade Out"
  ],
  "slowly bring the sound up at the start": [
   "Effect > Fading > Fade In"
  ],
  "theres a hissing noise in the background": [
   "Effect > Noise Removal and Repair > Noise Reduction..."
  ],
  "make my voice sound higher": [
   "Effect > Pitch and Tempo > Change Pitch..."
  ],
  "slow it down without making the voice sound weird and deep": [
   "Effect > Pitch and Tempo > Change Tempo..."
  ],
  "play it backwards": [
   "Effect > Special > Reverse"
  ],
  "add an echo": [
   "Effect > Delay and Reverb > Echo..."
  ],
  "too much bass, it sounds muddy": [
   "Effect > EQ and Filters > Bass and Treble..."
  ],
  "take out the long quiet pauses between talking": [
   "Effect > Special > Truncate Silence..."
  ],
  "put a marker here so i remember this spot": [
   "Edit > Labels > Add Label at Selection"
  ],
  "paano tanggalin yung ingay sa likod": [
   "Effect > Noise Removal and Repair > Noise Reduction..."
  ],
  "palakasin naman yung boses ko dito": [
   "Effect > Volume and Compression > Amplify...",
   "Effect > Volume and Compression > Normalize..."
  ],
  "i-save mo na as mp3 para ma-send ko": [
   "File > Export Audio..."
  ],
  "burahin mo tong part na to": [
   "Edit > Delete"
  ]
 }
