   "Edit > Select All"
  ],
  "put a little yellow note on here": [
   "Insert > Sticky Note"
  ],
  "draw a circle": [
   "Insert > Shape > Oval"
  ],
  "i want to type some words anywhere on the board": [
   "Insert > Text Box"
  ],
  "put a picture from my photos here": [
   "Insert > Choose Photo or Video"
  ],
  "draw an arrow pointing to something": [
   "Insert > Line with Arrowhead",
   "Insert > Shape > Arrow"
  ],
  "i need rows and boxes like a chart for my weekly schedule": [
   "Insert > Table"
  ],
  "how do i make writng thicker and darker": [
   "Format > Font > Bold"
  ],
  "the letters are too tiny to read": [
   "Format > Font > Bigger"
  ],
