   "Edit > Spelling and Grammar > Check Document Now"
  ],
  "read the words out loud to me": [
   "Edit > Speech > Start Speaking"
  ],
  "i want to talk instead of typing": [
   "Edit > Start Dictation…"
  ],
  "add a smiley face": [
   "Edit > Emoji & Symbols"
  ],
  "make all these words capital letters": [
   "Edit > Transformations > Make Upper Case"
  ],
