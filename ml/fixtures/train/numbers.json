 "goals": {
  "start a brand new spreadsheet": [
   "File > New…"
  ],
  "i-save mo na to": [
   "File > Save"
  ],
  "send this to my son but he only has excel": [
   "File > Export To > Excel…"
  ],
  "make it into a pdf": [
   "File > Export To > PDF…"
  ],
  "pa-print naman nito": [
   "File > Print…"
  ],
  "i want my family to be able to work on this with me": [
   "File > Share…"
  ],
  "undo that": [
   "Edit > Undo"
  ],
  "paano mag-add ng row sa baba": [
   "Table > Add Row Below"
  ],
  "i need another line above this one": [
   "Table > Add Row Above"
  ],
  "add a column to the right": [
   "Table > Add Column After"
  ],
  "get rid of this row": [
   "Table > Delete Row"
  ],
  "take out this whole column": [
   "Table > Delete Column"
  ],
  "add up all these numbers for me": [
   "Insert > Formula > Sum"
  ],
  "whats the average of these": [
   "Insert > Formula > Average"
  ],
  "gawin mong pie chart to": [
   "Insert > Chart > 2D Pie"
  ],
  "make a bar graph of my monthly bills": [
   "Insert > Chart > 2D Column",
   "Insert > Chart > 2D Bar"
  ],
  "join these boxes together into one big box": [
   "Table > Merge Cells"
  ],
  "the words dont fit in the box, make them go onto the next line": [
   "Table > Wrap Text"
  ],
  "make the column wide enough so i can read everything": [
   "Table > Resize Column to Fit Content"
  ],
  "put todays date in this box": [
   "Table > Insert Current Date"
  ],
  "put these in order from smallest to biggest": [
   "Organize > Show Sort Options"
  ],
  "only show me the rows from march": [
   "Organize > Show Filter Options"
  ],
  "keep the top row stuck there when i scroll down": [
   "Table > Freeze Header Rows"
  ],
  "add another page at the bottom tabs": [
   "Insert > Sheet"
  ],
  "its so tiny i cant see, make it bigger": [
   "View > Zoom > Zoom In"
  ],
  "make these letters bold": [
   "Format > Font > Bold"
  ],
  "put the words in the middle of the box": [
   "Format > Text > Align Center"
  ],
  "turn the box red when im over budget": [
   "Format > Conditional Highlighting…"
  ],
  "make a list with tick boxes": [
   "Insert > Table > Checklist"
  ],
  "leave a little note on this box for my wife to see": [
   "Insert > Comment"
  ],
  "hide these rows for now": [
   "Table > Hide Rows"
  ],
  "bring back the columns that disappeared": [
   "Table > Unhide All Columns"
  ],
  "copy the same thing all the way down the column": [
   "Table > Autofill Cells > Autofill Down"
  ],
  "look for a word in my spreadsheet": [
   "Edit > Find > Find…"
  ],
  "put a password on this so nobody else can open it": [
   "File > Set Password…"
  ]
 }
